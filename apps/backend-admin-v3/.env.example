DATABASE_URI=<DB_URI>
H2A_DATABASE_URI=<H2A_DB_URI>
PAYLOAD_SECRET=<PAYLOAD_SECRET>
TOKEN_SECRET=<TOKEN_SECRET>
PORT=3020
WEB_TYPE=default
PAYLOAD_PUBLIC_FRONTEND_URL=http://localhost:3000
PAYLOAD_PUBLIC_BACKEND_URL=http://localhost:3015
PAYLOAD_PUBLIC_BACKEND_URL_V2=http://localhost:3005
PAYLOAD_MIGRATION_TOKEN_V2=<PAYLOAD_MIGRATION_TOKEN_V2>
BASE_PATH=

# Disables Payload's dev-mode auto schema push (drizzle-kit push) so only
# committed migrations are applied. Set to true to avoid spurious DROP
# CONSTRAINT errors on PK id columns in versioned array/blocks/rels tables.
DISABLE_PAYLOAD_PUSH=true

# URLS
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3015
NEXT_PUBLIC_BACKEND_URL_V2=http://localhost:3005
NEXT_PUBLIC_BASE_PATH=/pv3

# Use https://ethereal.email/ for testing
SMTP_HOST=hostname.com
SMTP_PORT=111
SMTP_USER=test@email.com
SMTP_PASS=password
SMTP_FROM_ADDRESS=test@email.com
SMTP_FROM_NAME='test@email.com'
NODE_MAILER_TLS_REJECT_UNAUTHORIZED=false

PAYLOAD_FIRST_USER_EMAIL=default@payload.com
PAYLOAD_SEED=false

MICROSOFT_CLIENT_ID=MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET_VALUE=MICROSOFT_CLIENT_SECRET_VALUE
MICROSOFT_CLIENT_SECRET_KEY=MICROSOFT_CLIENT_SECRET_KEY
MICROSOFT_TENANT_ID=MICROSOFT_TENANT_ID
MICROSOFT_REDIRECT_URI=<SERVER_URL>/api/auth/microsoft/callback

#exchange mail
EXCHANGE_EWS_URL=https://domain.com/EWS/Exchange.asmx                                                      
EXCHANGE_OWA_BASE_URL=https://domain.com/owa                                                               
EXCHANGE_SERVICE_ACCOUNT_USER=test.email                                                      
EXCHANGE_SERVICE_ACCOUNT_PASSWORD=<EXCHANGE_SERVICE_ACCOUNT_PASSWORD>


OASYS_H2A_CLIENT_ID=OASYS_H2A_CLIENT_ID
OASYS_H2A_CLIENT_SECRET=OASYS_H2A_CLIENT_SECRET
OASYS_H2A_CLIENT_BASE_URL=OASYS_H2A_CLIENT_BASE_URL

# DocuSign eSignature integration (TECH-0114) — no env vars: credentials are
# entered in the admin UI at Settings > DocuSign (Integration Key, Account ID,
# Private Key, Environment), same pattern as H2A Oasys' client_id/secret. To
# obtain them for a sandbox setup:
# 1. Log in to https://account-d.docusign.com, go to Settings > Apps and Keys.
# 2. Create an Integration Key (a GUID) — enter it as "Integration Key" above.
# 3. On that Integration Key, click "Generate RSA" — download the private key
#    immediately (shown once only) and paste its full PEM contents into
#    "Private Key" above.
# 4. On the same page, note the "API Account ID" (a GUID, not the shorter
#    account number) — enter it as "Account ID" above.
# 5. Add a Redirect URI on the Integration Key matching the "Consent Redirect
#    URL" field above (a localhost URL is fine for dev).
# 6. Under Admin > Users, find your own DocuSign user's GUID — enter it as
#    "Status Reader User ID" above (dev: reuse your own account for this).
# 7. One-time only: visit
#    https://account-d.docusign.com/oauth/auth?response_type=code&scope=signature%20impersonation&client_id=<your Integration Key>&redirect_uri=<your Consent Redirect URL>
#    logged in as the user being impersonated, and click Allow — required once
#    per DocuSign user before any JWT token request for them will succeed.

JOBS_DISABLE_AUDIT_CLEANUP=true
JOBS_DISABLE_H2A_REFRESH=true
JOBS_DISABLE_H2A_SYNC_DEPT=true
JOBS_DISABLE_H2A_SYNC_USERS=true

# for testing email sending using jobs at /test/send-email
TEST_EMAIL_COUNT=10