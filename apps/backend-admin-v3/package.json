{
  "name": "do-app-backend-admin-v3",
  "version": "1.0.0",
  "description": "Doha Oasis Admin Panel V3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next dev -p $(node -e \"require('dotenv').config(); console.log(process.env.PORT || 3015)\")",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p ${PORT:-3015}",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:schema": "payload config:schema",
    "generate:types": "payload generate:types",
    "generate-test": "tsx scripts/generate-test-deduction.ts",
    "seed": "cross-env PAYLOAD_MIGRATING=true NODE_OPTIONS=--no-deprecation tsx scripts/run-seed.ts",
    "lint": "eslint src",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p ${PORT:-3015}",
    "start:pm2": "pm2 start \"yarn start\" --name \"do-app-backend-admin-v3\"",
    "start:prod": "pm2 delete do-app-backend-admin-v3 & pm2 delete do-app-backend-admin-v3-jobs & yarn install && yarn ci  &&  yarn build && yarn start:pm2 && yarn start:jobs:pm2",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:forms:crm": "yarn playwright test tests/e2e/forms-store-floor-customer-complaints.e2e.spec.ts tests/e2e/forms-guest-relations-custom-complaints.e2e.spec.ts tests/e2e/forms-printemps-incident-forms.e2e.spec.ts --project=chromium --headed --workers=1",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "migrate:latest": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload migrate",
    "ci": "yes | yarn migrate:latest && yarn build",
    "jobs:run": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:run --all-queues --cron \"*/10 * * * * *\" --handle-schedules",
    "jobs:run:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload jobs:run --all-queues --cron \"*/10 * * * * *\" --handle-schedules",
    "start:jobs:pm2": "pm2 start \"yarn jobs:run:prod\" --name \"do-app-backend-admin-v3-jobs\""
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.4",
    "@payloadcms/db-postgres": "3.63.0",
    "@payloadcms/email-nodemailer": "3.63.0",
    "@payloadcms/live-preview-react": "3.63.0",
    "@payloadcms/next": "3.63.0",
    "@payloadcms/payload-cloud": "3.63.0",
    "@payloadcms/plugin-form-builder": "3.63.0",
    "@payloadcms/richtext-lexical": "3.63.0",
    "@payloadcms/ui": "3.63.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.20",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "countries-list": "^3.3.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "docusign-esign": "^10.0.0",
    "docx-templates": "^4.15.0",
    "dotenv": "16.4.7",
    "easy-template-x": "^7.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "graphql": "^16.8.1",
    "html-to-docx": "^1.8.0",
    "html-to-image": "^1.11.13",
    "libreoffice-convert": "^1.8.1",
    "moment": "^2.30.1",
    "next": "15.4.8",
    "payload": "3.63.0",
    "payload-auditor": "^1.11.0",
    "pg": "8.16.3",
    "pg-dump-restore": "^1.0.15",
    "pizzip": "^3.2.0",
    "postcss": "^8.5.6",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-colorful": "^5.7.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.6.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "sharp": "0.34.2",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "xlsx-populate": "^1.21.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "@testing-library/react": "16.3.0",
    "@types/docusign-esign": "^5.19.9",
    "@types/file-saver": "^2.0.7",
    "@types/html-to-docx": "^1.8.0",
    "@types/node": "^22.5.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/react-signature-canvas": "^1.0.7",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "4.5.2",
    "daisyui": "^5.5.18",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.4",
    "jsdom": "26.1.0",
    "playwright": "1.54.1",
    "playwright-core": "1.54.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "browserslist": "> 1%",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
