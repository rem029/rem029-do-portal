@urlBase = http://localhost:3005
@url = {{urlBase}}/payload/api/items
@apiKey = {{survey-do api-token-dev}}
### ADD NOTE
POST {{url}}
Content-Type: application/json
Authorization: users API-Key {{apiKey}}

{      
      "name": "dohaquest-ifly-waiver-note",      
      "items": [
        {          
          "values": [
            {              
              "key": "en",
              "value": "All the flyers will be in Physical contact with the instructor while guiding, changing the body position and while controlling the movements of the flyer."
            },
            {              
              "key": "ar",
              "value": "سيكون جميع المحلقين على اتصال جسدي مع المدرب أثناء التوجيه وتغيير وضع الجسم وأثناء التحكم في حركات المسافر."
            }
          ]
        }
      ]
}

### ADD CHECKLIST
POST {{url}}
Content-Type: application/json
Authorization: users API-Key {{apiKey}}

{
    "id": 2,
    "name": "dohaquest-ifly-waiver-checklist",
    "description": "Checklist",
    "items": [
        {
            "id": "66379508dd7efb554a71c010",
            "values": [
                {
                    "id": "66379508dd7efb554a71c01a",
                    "key": "en",
                    "value": "All flyers must sign up to participate in this attraction (iFLY – Indoor skydiving) at Doha Quest."
                },
                {
                    "id": "66379508dd7efb554a71c01b",
                    "key": "ar",
                    "value": "يجب على جميع المحلقين التسجيل للمشاركة في هذه اللعبة (التحليق الداخلي) في \"كويست\"."
                }
            ]
        },
        {
            "id": "66379508dd7efb554a71c011",
            "values": [
                {
                    "id": "66379508dd7efb554a71c01c",
                    "key": "en",
                    "value": "All flying gear must be treated with respect; never step on the flight suits or drop the helmets."
                },
                {
                    "id": "66379508dd7efb554a71c01d",
                    "key": "ar",
                    "value": "يجب معاملة جميع معدات التحليق بكل حذر؛ لا تدوس على البدلة الخاصة بالتحليق ولا تسقط الخوذ."
                }
            ]
        },
        {
            "id": "66379508dd7efb554a71c012",
            "values": [
                {
                    "id": "66379508dd7efb554a71c01e",
                    "key": "en",
                    "value": "I agree for myself and/or the child(ren) to participate in the indoor flying skydiving, organized by Doha Quest."
                },
                {
                    "id": "66379508dd7efb554a71c01f",
                    "key": "ar",
                    "value": "أوافق على المشاركة بنفسي و/أو طفلي (الأطفال) في نفق التحليق الداخلي، الذي تنظمه كويست. "
                }
            ]
        },
        {
            "id": "66379508dd7efb554a71c013",
            "values": [
                {
                    "id": "66379508dd7efb554a71c020",
                    "key": "en",
                    "value": "I declare that in case I am not the parent or legal guardian of the child(ren), I have authority from the parent or legal guardian of the child(ren) to sign this Disclaimer and Waiver Form."
                },
                {
                    "id": "66379508dd7efb554a71c021",
                    "key": "ar",
                    "value": "أقر أنه في حال لم أكن الوالد أو الوصي القانوني على الطفل (الأطفال)، لدي سلطة من الوالد أو الوصي القانوني على الطفل (الأطفال) للتوقيع على نموذج إخلاء المسؤولية والتنازل هذا."
                }
            ]
        },
        {
            "id": "66379508dd7efb554a71c014",
            "values": [
                {
                    "id": "66379508dd7efb554a71c022",
                    "key": "en",
                    "value": "I declare that I understand and acknowledge the attraction rules, regulations, and restrictions. I and the child(ren) will abide by them."
                },
                {
                    "id": "66379508dd7efb554a71c023",
                    "key": "ar",
                    "value": "أقر أنني أفهم وأقر بقواعد وأنظمة وقيود اللعبة. وأتعهد بالالتزام بها أنا و/أو طفلي (الأطفال)"
                }
            ]
        },
        {
            "id": "66379508dd7efb554a71c015",
            "values": [
                {
                    "id": "66379508dd7efb554a71c024",
                    "key": "en",
                    "value": "I confirm that I do not know of any medical condition that I or any of the child(ren) suffer from which might result in any incident that could result in injury to myself, child(ren), or others during the activity."
                },
                {
                    "id": "66379508dd7efb554a71c025",
                    "key": "ar",
                    "value": "أؤكد عدم معرفتي بأي حالة طبية قد أعاني منها أنا أو أحد الأطفال، والتي قد تؤدي إلى أي حادث قد يؤدي إلى إصابتي أو إصابة الطفل (الأطفال) أو الآخرين أثناء النشاط."
                }
            ]
        },
        {
            "id": "66379508dd7efb554a71c016",
            "values": [
                {
                    "id": "66379508dd7efb554a71c026",
                    "key": "en",
                    "value": "I acknowledge that there are inherent risks associated with the above-mentioned activity, and I accept the full risk of personal injury and its consequences or property damage. I accept this risk on my behalf and on behalf of the child(ren)."
                },
                {
                    "id": "66379508dd7efb554a71c027",
                    "key": "ar",
                    "value": "أقر بأن هناك مخاطر طبيعية مرتبطة بالنشاط المذكور أعلاه، وأقبل المخاطر الكاملة للإصابة الشخصية وعواقبها أو تلف الممتلكات ."
                }
            ]
        },
        {
            "id": "66379508dd7efb554a71c017",
            "values": [
                {
                    "id": "66379508dd7efb554a71c028",
                    "key": "en",
                    "value": "I hereby release, waive, forever hold harmless, indemnify, and keep indemnified Doha Quest from all claims for any injury, loss, or damage sustained by me and/or the child(ren) in my custody arising from or in connection with the activity mentioned above. I hereby indemnify Doha Quest against all claims made by any other person against Doha Quest in respect of any injury, loss, or damage arising out of or in connection with my failure and/or the failure of the child(ren) to follow general restrictions and instructions and/or directions of Doha Quest, its management, and/or staff."
                },
                {
                    "id": "66379508dd7efb554a71c029",
                    "key": "ar",
                    "value": "أقبل هذه المخاطرة نيابة عني ونيابة عن الطفل (الأطفال)\nأتعهد بعدم مطالبة \"كويست\" من أي إصابة أو خسارة أو ضرر ناتج عن النشاط المشار إليه أعلاه. وأتعهد بتعويض \"كويست\" عن أي \nمطالبة تقدم بها أي شخص آخر فيما يتعلق بالإصابة أو الخسارة أو الضرر ناتج عن فشلي و/أو فشل الأطفال في اتباع القيود والتعليمات و/أو التوجيهات العامة لـ \"كويست\"، وإدارتها، و/أو موظفيها .\n"
                }
            ]
        },
        {
            "id": "66379508dd7efb554a71c018",
            "values": [
                {
                    "id": "66379508dd7efb554a71c02a",
                    "key": "en",
                    "value": "I acknowledge and accept that this form may be pleaded in the defense to any action, or proceedings taken by me and/or the child(ren) at any time against Doha Quest arising out of or in connection with my and/or the child(ren)'s participation in the activity."
                },
                {
                    "id": "66379508dd7efb554a71c02b",
                    "key": "ar",
                    "value": "أتعهد وأقبل بأن يمكن استخدام هذا النموذج في الدفاع عن أي إجراء قانوني يتخذه أنا و/أو الأطفال في أي وقت ضد \"كويست\" بسبب مشاركتي و/أو مشاركة الأطفال في النشاط."
                }
            ]
        }
    ],
    "updatedAt": "2024-05-14T11:55:51.765Z",
    "createdAt": "2024-05-05T09:19:57.918Z"
}


### ADD TERMS
POST {{url}}
Content-Type: application/json
Authorization: users API-Key {{apiKey}}

{    
    "name": "dohaquest-ifly-waiver-terms",
    "description": "Terms",
    "items": [

    {
    "id": "66407fdb91e5565c85a8fd16",

    "values": [

    {
    "id": "66407fe991e5565c85a8fd17",
    "key": "en",
    "value": "I agree that I am and/or my child is voluntarily participating in the activities offered by Quest iFLY Indoor Skydiving and understand that Quest iFLY Indoor Skydiving is not a ride but rather an interactive experience which simulates freefall skydiving by exposing me and/or my child(ren) to vertical winds of up to 220 miles per hour, and that it is an inherently dangerous activity."
    },

    {
    "id": "66407ff591e5565c85a8fd18",
    "key": "ar",
    "value": "أتفق على أنني و/أو طفلي مشترك بشكل طوعي في هذا النشاط الذي تقدمه \"كويست\" للتحليق الحر الداخلي وأدرك أنها تجربة تفاعلية تحاكي القفز بالمظلة الحرة عن طريق تعريضي و/أو طفلي)أطفالي( لرياح رأسية تصل إلى 220 ميلاً في الساعة، وأنها نشاط خطير بشكل طبيعي. "
    }
    ]
    },

    {
    "id": "66379505dd7efb554a71bff5",

    "values": [

    {
    "id": "66379505dd7efb554a71bffe",
    "key": "en",
    "value": "I understand and assume the risk of injury or disability related to this activity, for myself and/or my child, and I take full responsibility for my/child(ren)'s participation in all activities. "
    },

    {
    "id": "66379505dd7efb554a71bfff",
    "key": "ar",
    "value": "أفهم وأتحمل المسؤولية عن مخاطر الإصابة أو العجز المتعلقة بهذا النشاط، بالنسبة لي و/أو لطفلي، وأتحمل كامل المسؤولية عن مشاركتي/مشاركة طفلي (أطفالي) في جميع الأنشطة."
    }
    ]
    },

    {
    "id": "66379505dd7efb554a71bff6",

    "values": [

    {
    "id": "66379505dd7efb554a71c000",
    "key": "en",
    "value": "I am aware that during the iFLY experience, my body will be subjected to high atmospheric pressure, and if I have a history of nosebleeds, I will inform the instructor."
    },

    {
    "id": "66379505dd7efb554a71c001",
    "key": "ar",
    "value": "أفهم وأتحمل مسؤولية أن جسمي سيتعرض لضغط جوي عالي أثناء تجربة التحليق الداخلي، وإذا كان لدي تاريخ من نزيف الأنف، سأخبر المدرب."
    }
    ]
    },

    {
    "id": "66379505dd7efb554a71bff7",

    "values": [

    {
    "id": "66379505dd7efb554a71c002",
    "key": "en",
    "value": "I confirm that I (or my child) have never had a shoulder dislocation. If I (or my child) have had a shoulder dislocation, I have brought this to the attention of a member of the Quest iFLY Indoor Skydiving staff."
    },

    {
    "id": "66379505dd7efb554a71c003",
    "key": "ar",
    "value": "أؤكد أنني أو طفلي لم أتعرض مطلقًا لخلع في الكتف. إذا كنت (أو طفلي) قد تعرضت لخلع في الكتف، فقد قمت بلفت انتباه أحد أعضاء فريق عمل كويست إلى هذا الأمر."
    }
    ]
    },

    {
    "id": "66379505dd7efb554a71bff8",

    "values": [

    {
    "id": "66379505dd7efb554a71c004",
    "key": "en",
    "value": "I am personally responsible for any insurance deemed necessary to cover my risk, and I have become aware of the extent to which my accident insurance covers any bodily injury or property damage in connection with my participation in activities at iFly."
    },

    {
    "id": "66379505dd7efb554a71c005",
    "key": "ar",
    "value": "أنا مسؤول شخصيًا عن أي تأمين يعتبر ضوريًا لتغطية المخاطر يمكنني التعرض لها ،وأنا على دراية بمدى تغطية التأمين ضد الحوادث لأي إصابة جسدية أو أضرار في الممتلكات فيما يتعلق بمشاركتي في لعبة اي فلاي."
    }
    ]
    },

    {
    "id": "66379505dd7efb554a71bff9",

    "values": [

    {
    "id": "66379505dd7efb554a71c006",
    "key": "en",
    "value": "This Waiver and Release of all liability includes, without limitation, injuries, illness, or accidents, which may occur because of (a) use of the facility (b) use of any equipment which may malfunction or break, (c) instruction or supervision."
    },

    {
    "id": "66379505dd7efb554a71c007",
    "key": "ar",
    "value": "يشمل هذا التنازل والإعفاء من كافة المسؤوليات، عل سبيل المثال لا الحصر، الإصابات أو الأمراض أو الحوادث التي قد تحدث بسبب استخدام المنشأة و باستخدام أي معدات قد تتعطل أو تنكسر. "
    }
    ]
    },

    {
    "id": "66379505dd7efb554a71bffa",

    "values": [

    {
    "id": "66379505dd7efb554a71c008",
    "key": "en",
    "value": "I have read and have clearly understood everything on the Disclaimer board."
    },

    {
    "id": "66379505dd7efb554a71c009",
    "key": "ar",
    "value": "لقد قرأت وفهمت بوضوح كل شيء في لوائح قواعد اللعبة . "
    }
    ]
    },

    {
    "id": "66379505dd7efb554a71bffb",

    "values": [

    {
    "id": "66379505dd7efb554a71c00a",
    "key": "en",
    "value": "I waive the right to claim any damages from Doha Quest and employees, including instructors, operators, receptionists, and others. I also promise to indemnify Doha Quest for any liability to pay damages arising out of my participation."
    },

    {
    "id": "66379505dd7efb554a71c00b",
    "key": "ar",
    "value": "أتنازل عن اي حق في المطالبة بأي تعويضات من شركة كويست وموظفيها، بما في ذلك المدربين والمشغلين وموظق الاستقبال وغيرهم. وأتعهد أيضًا بتعويض شركة كويست عن أي اضرار بدفع تعويضات ناشئة عن مشاركتي في التحليق الداخلي الجسدي. "
    }
    ]
    },

    {
    "id": "66379505dd7efb554a71bffc",

    "values": [

    {
    "id": "66379505dd7efb554a71c00c",
    "key": "en",
    "value": "I confirm that I am 13 years of age or older and acknowledge that I have read and fully understand the above prior to signing below. Please note: Guardian should be above the age of 18 years. Any person deemed by the management to."
    },

    {
    "id": "66379505dd7efb554a71c00d",
    "key": "ar",
    "value": "أؤكد أنني أبلغ من العمر 13 عامًا أو أكثر، وأقر بأنني قرأت وفهمت بشكل كامل ما ذكُر أعلاه قبل التوقيع أدناه. يرجى ملاحظة: يجب أن يكون ولي الأمر فوق سن 18 عامًا. \n"
    }
    ]
    }
    ],
    "updatedAt": "2024-05-14T11:45:46.563Z",
    "createdAt": "2024-05-05T14:17:41.815Z"
}

